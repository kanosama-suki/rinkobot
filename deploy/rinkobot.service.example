# Rinkobot 独立核心 systemd 示例。
# 复制到 /etc/systemd/system/rinkobot.service 后按实际路径修改。
# 不要把 token、API key、QQ 凭据或 SSH 私钥写进本文件。

[Unit]
Description=Rinkobot standalone companion core
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rinkobot
Group=rinkobot
WorkingDirectory=/opt/rinkobot/a
ExecStart=/usr/bin/node /opt/rinkobot/a/scripts/app-server.ts --config /var/lib/rinkobot/config --data /var/lib/rinkobot/data --port 4200
EnvironmentFile=/etc/rinkobot/rinkobot.env
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rinkobot
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
PrivateDevices=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SyslogIdentifier=rinkobot
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
