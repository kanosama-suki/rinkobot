# Kanobot 独立核心 systemd 示例。
# 复制到 /etc/systemd/system/kanobot.service 后按实际路径修改。
# 不要把 token、API key、QQ 凭据或 SSH 私钥写进本文件。

[Unit]
Description=Kanobot standalone companion core
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kanobot
Group=kanobot
WorkingDirectory=/opt/kanobot/a
ExecStart=/usr/bin/node /opt/kanobot/a/scripts/app-server.ts --config /var/lib/kanobot/config --data /var/lib/kanobot/data --port 4200
EnvironmentFile=/etc/kanobot/kanobot.env
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/kanobot
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
PrivateDevices=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SyslogIdentifier=kanobot
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
