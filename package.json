{
  "name": "@kanobot/dsh-plugin",
  "version": "0.16.0",
  "private": true,
  "description": "Kanobot companion runtime for DSH and standalone hosting",
  "type": "module",
  "exports": {
    ".": "./src/plugin/index.ts",
    "./config": "./src/core/config/index.ts"
  },
  "files": [
    "src",
    "scripts",
    "config",
    "docs/*.md",
    "locale",
    "icon.svg",
    "README.md",
    "AGENTS.md",
    "structure.md"
  ],
  "scripts": {
    "app": "node scripts/app-server.ts",
    "dev": "node scripts/dev-server.ts",
    "start": "node scripts/app-server.ts",
    "test": "node --test",
    "check:case": "node scripts/check-import-case.ts",
    "check": "npm run check:case && npm test",
    "config:check": "node scripts/validate-config.ts config/examples",
    "preflight": "node scripts/preflight-runtime.ts",
    "test:lifecycle": "node scripts/m1-lifecycle.ts"
  },
  "dependencies": {
    "smol-toml": "1.9.1",
    "ws": "8.22.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./src/plugin/cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "UNLICENSED"
}
