{
  "name": "kanobot",
  "version": "0.21.0",
  "private": true,
  "description": "A self-hosted companion robot runtime with persistent memory, reminders, and QQ channels",
  "type": "module",
  "files": [
    "src",
    "scripts",
    "config/examples",
    "deploy",
    "docs",
    "icon.svg",
    "README.md",
    "AGENTS.md",
    "structure.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "app": "node scripts/app-server.ts",
    "backup": "node scripts/backup.ts",
    "dev": "node scripts/dev-server.ts",
    "login": "node scripts/login-url.ts",
    "start": "node scripts/app-server.ts",
    "test": "node --test",
    "check:case": "node scripts/check-import-case.ts",
    "check": "npm run check:case && npm test",
    "config:check": "node scripts/validate-config.ts config/examples",
    "preflight": "node scripts/preflight-runtime.ts"
  },
  "dependencies": {
    "smol-toml": "1.9.1",
    "ws": "8.22.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "MIT"
}
